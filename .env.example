# Copy this file to .env and fill in the keys you want to test.
# Suites for providers without a key are skipped automatically.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local) — only needed if you want to run Ollama tests
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
